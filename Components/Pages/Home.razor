@page "/"
@rendermode InteractiveServer
@inject App08_TodoDb.Services.TodoDbService TodoService

<PageTitle>To-Do Database - App 08</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="text-center mb-4">
                <h2 class="fw-bold text-dark">To-Do List</h2>
                <p class="text-muted">Connected to SQL Server — AutoCareDB</p>
            </div>
            <div class="card border-0 shadow" style="border-radius:16px; overflow:hidden;">
                <div class="card-header py-3 px-4 text-white fw-bold" style="background:#2563eb; border-radius:16px 16px 0 0;">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Tasks</span>
                        <span class="badge bg-white text-primary">@tasks.Count task@(tasks.Count == 1 ? "" : "s")</span>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible rounded-3 border-0">
                            @errorMessage
                            <button type="button" class="btn-close" @onclick="@(() => errorMessage = string.Empty)"></button>
                        </div>
                    }
                    <div class="input-group mb-4">
                        <input @bind="newTaskTitle" @bind:event="oninput" @onkeydown="HandleKeyDown"
                               class="form-control form-control-lg"
                               placeholder="Add a new task and press Enter..." />
                        <button class="btn text-white fw-bold px-4"
                                style="background:#2563eb; border:none;"
                                @onclick="AddTask"
                                disabled="@(string.IsNullOrWhiteSpace(newTaskTitle) || isSaving)">
                            @(isSaving ? "..." : "+ Add")
                        </button>
                    </div>
                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted">Loading from database...</p>
                        </div>
                    }
                    else if (tasks.Count == 0)
                    {
                        <div class="text-center py-4">
                            <div style="font-size:3rem;">🗄️</div>
                            <p class="text-muted mt-2">No tasks in the database. Add one above!</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var task in tasks)
                        {
                            <div class="d-flex align-items-center gap-3 px-2 py-3 border-bottom">
                                @if (editingTaskId == task.Id)
                                {
                                    <div class="input-group flex-grow-1">
                                        <input @bind="editTitle" @bind:event="oninput" class="form-control" />
                                        <button class="btn btn-success btn-sm" @onclick="() => SaveEdit(task.Id)">Save</button>
                                        <button class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <input type="checkbox" class="form-check-input mt-0 flex-shrink-0"
                                           style="width:20px;height:20px;cursor:pointer;"
                                           checked="@task.IsCompleted" @onchange="() => ToggleTask(task.Id)" />
                                    <div class="flex-grow-1">
                                        <span class="text-dark @(task.IsCompleted ? "text-decoration-line-through text-muted" : "fw-semibold")">
                                            @task.Title
                                        </span>
                                        <div class="text-muted" style="font-size:0.72rem;">
                                            ID: @task.Id · @task.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")
                                        </div>
                                    </div>
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => StartEdit(task)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => DeleteTask(task.Id)">Delete</button>
                                    </div>
                                }
                            </div>
                        }
                        <div class="d-flex gap-2 mt-3">
                            <button class="btn btn-danger flex-fill rounded-pill fw-semibold" @onclick="ClearAll">Clear All</button>
                            <button class="btn btn-outline-secondary flex-fill rounded-pill fw-semibold" @onclick="LoadTasks">Refresh</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<App08_TodoDb.Data.TodoTask> tasks = new();
    private string newTaskTitle = "";
    private string errorMessage = "";
    private bool isLoading = true;
    private bool isSaving = false;
    private int? editingTaskId = null;
    private string editTitle = "";

    protected override async Task OnInitializedAsync() => await LoadTasks();

    private async Task LoadTasks()
    {
        isLoading = true;
        try { tasks = await TodoService.GetAllAsync(); }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskTitle)) return;
        isSaving = true;
        try { await TodoService.AddAsync(newTaskTitle); newTaskTitle = ""; await LoadTasks(); }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        finally { isSaving = false; }
    }

    private async Task ToggleTask(int id)
    {
        try { await TodoService.ToggleAsync(id); await LoadTasks(); }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
    }

    private void StartEdit(App08_TodoDb.Data.TodoTask task) { editingTaskId = task.Id; editTitle = task.Title; }

    private async Task SaveEdit(int id)
    {
        if (!string.IsNullOrWhiteSpace(editTitle))
            try { await TodoService.UpdateAsync(id, editTitle); await LoadTasks(); }
            catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
        editingTaskId = null;
    }

    private void CancelEdit() => editingTaskId = null;

    private async Task DeleteTask(int id)
    {
        try { await TodoService.DeleteAsync(id); await LoadTasks(); }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
    }

    private async Task ClearAll()
    {
        try { await TodoService.ClearAllAsync(); await LoadTasks(); }
        catch (Exception ex) { errorMessage = $"Error: {ex.Message}"; }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) { if (e.Key == "Enter") await AddTask(); }
}
